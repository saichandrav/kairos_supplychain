# Kairos environment (plan §7). Copy to .env (gitignored) and fill in. Never commit real values.

# Database backend: hana (shared Hackfest HANA Cloud) or sqlite (offline fallback, data/kairos.sqlite)
DB_BACKEND=
# HANA Cloud SQL endpoint host (from HANA Cloud Central)
HANA_HOST=
# HANA SQL port; HANA Cloud uses 443 with TLS
HANA_PORT=
# HANA database user (HACKFEST0xxx)
HANA_USER=
# HANA password (shared across participants; treat the DB as untrusted)
HANA_PASSWORD=
# Default schema for all FF_ objects (normally the same as HANA_USER)
HANA_SCHEMA=
# SAP API Business Hub sandbox key (read-only master-data validation)
SAP_API_HUB_KEY=
# LLM used only for narrative text: anthropic | sap_genai_hub | none
LLM_PROVIDER=
# Model id for the chosen LLM provider
LLM_MODEL=
# Anthropic API key (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# OpenRouter API key (for Disruption Sensing Agent AI classification)
OPENROUTER_API_KEY=
# OpenRouter model id (default: openai/gpt-4o-mini)
OPENROUTER_MODEL=
# Shared API key header that SAP Build Apps sends to FastAPI
APP_API_KEY=
# NewsAPI.org key for live maritime/trade news (Live Sensing "Check live conditions").
# Free at https://newsapi.org/register (email only, no card) - Developer plan, 100 req/day.
# Marine weather (Open-Meteo) needs no key and works even if this is left blank.
NEWSAPI_KEY=
